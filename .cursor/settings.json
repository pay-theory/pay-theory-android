{
  "kotlin.diagnostics.enabled": false,
  "java.diagnostics.enabled": false,
  "typescript.diagnostics.enabled": false,
  "eslint.enable": false,
  "auto_format": false,
  "language_server.kotlin.enabled": false,
  "language_server.java.enabled": false,
  "code_actions_on_save.enabled": false,
  "format_on_save": false,

  "java.configuration.updateBuildConfiguration": "automatic",
  "java.project.referencedLibraries": {
    "include": [
      "lib/**/*.jar"
    ]
  },
  "java.configuration.compile.nullAnalysis.mode": "automatic",
  "java.dependency.packagePresentation": "hierarchical"
} 